<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Properties>
        <!-- Log pattern for both console and files -->
        <Property name="LOG_PATTERN">[%-5level] %d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %c{1} - %msg%n</Property>
        <!-- Log directory -->
        <Property name="APP_LOG_ROOT">logs</Property>
    </Properties>

    <Appenders>
        <!-- Console output -->
        <Console name="LogToConsole" target="SYSTEM_OUT">
            <PatternLayout pattern="${LOG_PATTERN}" />
        </Console>

        <!-- Main application rolling file -->
        <RollingFile name="LogToRollingFile"
                     fileName="${APP_LOG_ROOT}/application.log"
                     filePattern="${APP_LOG_ROOT}/application-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout>
                <Pattern>${LOG_PATTERN}</Pattern>
            </PatternLayout>
            <Policies>
                <!-- Roll logs daily and every 2MB -->
                <TimeBasedTriggeringPolicy />
                <SizeBasedTriggeringPolicy size="2MB" />
            </Policies>
            <!-- Keep up to 30 rolled files per day -->
            <DefaultRolloverStrategy fileIndex="min" max="30" />
        </RollingFile>

        <!-- Separate error log for errors/exceptions only -->
        <RollingFile name="ErrorFile"
                     fileName="${APP_LOG_ROOT}/error.log"
                     filePattern="${APP_LOG_ROOT}/error-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout>
                <Pattern>${LOG_PATTERN}</Pattern>
            </PatternLayout>
            <Policies>
                <TimeBasedTriggeringPolicy />
                <SizeBasedTriggeringPolicy size="2MB" />
            </Policies>
            <DefaultRolloverStrategy fileIndex="min" max="30" />
            <!-- Only capture ERROR and FATAL messages -->
            <Filters>
                <ThresholdFilter level="error" onMatch="ACCEPT" onMismatch="DENY" />
            </Filters>
        </RollingFile>
    </Appenders>

    <Loggers>
        <!-- SQL debugging (JDBC) -->
        <Logger name="org.springframework.jdbc.core.JdbcTemplate" level="trace" additivity="false">
            <AppenderRef ref="LogToRollingFile" />
        </Logger>
        <Logger name="org.springframework.jdbc.core.StatementCreatorUtils" level="trace" additivity="false">
            <AppenderRef ref="LogToRollingFile" />
        </Logger>

        <!-- Application-specific logs -->
        <Logger name="com.eljuntobookclub" level="debug" additivity="false">
            <AppenderRef ref="LogToRollingFile" />
            <AppenderRef ref="ErrorFile" />
            <AppenderRef ref="LogToConsole" />
        </Logger>

        <!-- Root logger -->
        <Root level="info">
            <AppenderRef ref="LogToRollingFile" />
            <AppenderRef ref="ErrorFile" />
            <AppenderRef ref="LogToConsole" />
        </Root>
    </Loggers>
</Configuration>
